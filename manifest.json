{
  "manifest_version": 3,
  "name": "sunyai extension manager",
  "version": "2.0.0",
  "description": "Autonomous bookmark organizer and smart tab manager. Sub-millisecond categorization, domain tab grouping, and side panel navigation.",
  "short_name": "sunyai",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting",
    "windows",
    "tabs",
    "tabGroups",
    "sidePanel"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?context=sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "focus-left": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Focus Tab Group Left"
    },
    "focus-right": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Focus Tab Group Right"
    },
    "toggle-current-group": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Toggle expand/collapse current Tab Group"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open sunyai extension manager"
    }
  },
  "homepage_url": "https://github.com/basantzp/sunyai-extension-manager"
}
